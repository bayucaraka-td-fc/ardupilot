# Bootloader HWDEF for Bayusuta (Main FC)

MCU STM32H7xx STM32H743xx
OSCILLATOR_HZ 25000000

# Flash configuration
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

APJ_BOARD_ID 1038

# USB
PA9 USB_VBUS INPUT OPENDRAIN
PA10 USB_ID INPUT
PA11 USB_DM OTG1
PA12 USB_DP OTG1

# LEDs
PB0 LED_A OUTPUT HIGH
PB1 LED_B OUTPUT HIGH
PB2 LED_C OUTPUT HIGH
PB3 LED_D OUTPUT HIGH
PB4 LED_E OUTPUT HIGH
PB5 LED_F OUTPUT HIGH

define HAL_GPIO_A_LED_PIN 0
define HAL_GPIO_B_LED_PIN 1
define HAL_GPIO_C_LED_PIN 2

# Bootloader Serial Port (optional, USB is primary)
# We can use UART4 as standard telemetry for BL
PA0 UART4_TX UART4
PA1 UART4_RX UART4

# Order
SERIAL_ORDER OTG1 UART4
define CH_CFG_USE_MUTEXES 1

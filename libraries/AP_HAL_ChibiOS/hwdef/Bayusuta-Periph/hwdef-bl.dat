# hw definition file for processing by chibios_hwdef.py
# Bayusuta-Periph (NAVC) bootloader, STM32F405RGT6

# MCU class and specific type
MCU STM32F4xx STM32F405xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_Bayusuta-Periph

# setup build for a peripheral firmware
env AP_PERIPH 1

# crystal frequency (ABM8G 24 MHz HSE)
OSCILLATOR_HZ 24000000

FLASH_SIZE_KB 1024

# bootloader starts at zero offset
FLASH_RESERVE_START_KB 0

# the location where the bootloader will put the firmware.
# note: parameters live in flash sectors 2 and 3 (32k-64k), so the
# bootloader itself must stay under 32k
FLASH_BOOTLOADER_LOAD_KB 64

# LED_A as bootloader activity LED (active high)
PC3 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 1

# allow bootloading on USB; DroneCAN flashing works via CAN1
SERIAL_ORDER OTG1

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# enable CAN support (DroneCAN firmware update)
PB8 CAN1_RX CAN1
PB9 CAN1_TX CAN1

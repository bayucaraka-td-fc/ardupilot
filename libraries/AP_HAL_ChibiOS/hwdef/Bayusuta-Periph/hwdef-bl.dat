# Bootloader HWDEF for Bayusuta-Periph (Coprocessor)

MCU STM32F4xx STM32F405xx
OSCILLATOR_HZ 8000000

# Flash configuration
FLASH_SIZE_KB 1024
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 64

APJ_BOARD_ID 1039

# USB
PA9 USB_VBUS INPUT OPENDRAIN
PA10 USB_ID INPUT
PA11 USB_DM OTG1
PA12 USB_DP OTG1

# LEDs
PB12 LED_A OUTPUT HIGH
PB13 LED_B OUTPUT HIGH
PB14 LED_C OUTPUT HIGH
PB15 LED_D OUTPUT HIGH

define HAL_GPIO_A_LED_PIN 12
define HAL_GPIO_B_LED_PIN 13
define HAL_GPIO_C_LED_PIN 14

# Bootloader Serial Port (optional, USB is primary)
PC10 USART3_TX USART3
PC11 USART3_RX USART3

# Order
SERIAL_ORDER OTG1 USART3
define CH_CFG_USE_MUTEXES 1
